{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <probe-dir>/hook.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node <probe-dir>/hook.js"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Write"
    ]
  }
}